# DevOS environment — copy to .env (install.sh does this automatically)
DEBUG=true
JWT_SECRET=
SECRET_KEY=

# Auth: local | supabase | dual
AUTH_MODE=dual

# Bootstrap admin (created on first start if no admin user exists)
ADMIN_USER=Admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=123456..

# Database (default SQLite is fully self-contained)
DATABASE_URL=sqlite+aiosqlite:///./data/devos.db

# LLM — pick one; Ollama needs no cloud key
DEFAULT_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# Optional search
# TAVILY_API_KEY=

# Optional multi-node (leave empty for single-machine)
# REDIS_URL=
# DEVOS_MULTI_NODE=false

# Server
# HOST=0.0.0.0
# PORT=8000
ENABLE_API_DOCS=true
