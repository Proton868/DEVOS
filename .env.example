# Production: set DEVOS_DEPLOY_MODE=production (or DEBUG=false) — startup fails closed
# on weak secrets, SQLite SoT, or localhost-only ALLOWED_ORIGINS.
# DEVOS_DEPLOY_MODE=production
# DEVOS_STRICT_PRODUCTION=1
# DevOS environment — copy to .env (ops/install.sh does this once; never commits .env)
# Production: REQUIRE_POSTGRES=true, Postgres/Supabase DATABASE_URL, DEBUG=false,
# strong JWT_SECRET (>=32 chars), non-default ADMIN_PASSWORD.
# Validate:  .venv/bin/python ops/env_validate.py --env-file .env --production
#
# DevOS environment — copy to .env (install.sh does this automatically)
DEBUG=false
JWT_SECRET=
SECRET_KEY=

# Auth: local | supabase | dual
AUTH_MODE=dual

# Bootstrap admin (created on first start if no admin user exists)
ADMIN_USER=Admin
ADMIN_EMAIL=a
ADMIN_PASSWORD=
# Leave empty to auto-generate a strong admin password on first boot

# Database (default SQLite is fully self-contained)
# Supabase/Postgres is the single source of truth (required).
# Project ref: heinpngifdqsykqzufhe
# DATABASE_URL=postgresql+psycopg://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://devos:devos@127.0.0.1:5432/devos
REQUIRE_POSTGRES=true

# LLM — pick one; Ollama needs no cloud key
# OmniRoute native AI gateway (OpenAI-compatible). Upstream keys live in OmniRoute.
DEFAULT_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://127.0.0.1:3000/api/v1
# OMNIROUTE_API_KEY=
# OMNIROUTE_DEFAULT_MODEL=
# OMNIROUTE_TIMEOUT=90

OLLAMA_HOST=http://127.0.0.1:11434
OPENROUTER_DEFAULT_MODEL=openrouter/free
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# Optional search
# TAVILY_API_KEY=

# Optional multi-node (leave empty for single-machine)
# REDIS_URL=
# DEVOS_MULTI_NODE=false

# Server
# HOST=0.0.0.0
# PORT=8000
ENABLE_API_DOCS=true

# ── PRODUCTION NOTES ──────────────────────────────────────────
# DEBUG=false
# AUTH_MODE=supabase          # or dual during migration
# JWT_SECRET=<long-random>
# ADMIN_PASSWORD=<strong-unique>   # or leave empty to auto-generate once
#   Known example defaults (123456..) are REJECTED when DEBUG=false
# ALLOWED_ORIGINS=https://your.domain
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=<server-side key for backend only — never ship to browser>
# SUPABASE_ANON_KEY=<publishable anon key for browser / public-config>
# REQUIRED for supabase_configured=true in /api/auth/public-config (URL alone is not enough)
# PUBLIC_APP_URL=https://dev.carai.agency
# SUPABASE_JWT_SECRET=<legacy HS256 jwt secret if project still uses it>
# AUTH_MODE=dual   # dual | local | supabase — production prefers dual or supabase
# SECRET_KEY / vault: cryptography key material for secrets_vault
# ENABLE_API_DOCS=false
# Workflow definitions are persisted in the application database

# Sandbox isolation (production: enable Docker)
# DEVOS_USE_DOCKER_SANDBOX=1
# DEVOS_SANDBOX_PYTHON_IMAGE=python:3.13-slim
# DEVOS_ALLOW_DEGRADED_ISOLATION=1   # DEV ONLY — never in production


# ── Mission orchestration (optional) ───────────────────────
# DEVOS_ORCH_MAX_PARALLEL=3
# Fake runtime is TEST ONLY — never enable in production:
# DEVOS_ORCH_FAKE_RUNTIME=0
# DEVOS_ALLOW_FAKE_RUNTIME=0

# --- Delivery / Preview / Deploy (optional) ---
# PREVIEW_ORIGIN=https://preview.example.com
# PREVIEW_TOKEN_TTL=900
# VERCEL_TOKEN=
# NETLIFY_TOKEN=
# CLOUDFLARE_TOKEN=
# GITHUB_TOKEN=
# DEVOS_MAX_UPLOAD_SIZE=52428800
# DEVOS_MAX_ARCHIVE_FILES=5000

# SQLAlchemy SQL statement logging (default off — keep off in production)
# SQL_ECHO=false

# ENCRYPTION_KEY=
# SECRET_KEY=
