{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-json-schema/main/tauri.config.json",
  "productName": "DevOS",
  "version": "4.0.0",
  "identifier": "com.devos.desktop",
  "build": {
    "beforeDevCommand": "cd frontend-src && npm run build",
    "devUrl": "http://localhost:8000",
    "beforeBuildCommand": "cd frontend-src && npm run build",
    "frontendDist": "../frontend-src/build"
  },
  "app": {
    "title": "DevOS",
    "windows": [
      {
        "title": "DevOS",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:8000; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-eval' 'unsafe-inline'; connect-src 'self' http://localhost:8000 ws://localhost:8000"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "DevOS",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Agency Operating System",
    "longDescription": "DevOS is an AI-native operating system for software development. Code, deploy, and manage your entire stack with AI agents.",
    "copyright": "2024 DevOS",
    "publisher": "DevOS"
  },
  "plugins": {
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "devos-server",
          "cmd": "python",
          "args": ["-m", "uvicorn", "app:app", "--host", "127.0.0.1", "--port", "8000"]
        }
      ]
    },
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_PUBKEY",
      "endpoints": [
        "https://releases.devos.dev/{{target}}/{{current_version}}"
      ]
    }
  }
}
